generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Application {
  id          String             @id @default(cuid())
  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  supplierId  String
  category    Category           @relation(fields: [categoryId], references: [id])
  categoryId  String
  status      application_status @default(draft)
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  remarks     String?
  createdAt   DateTime           @default(now())
  documents   Document[]
  payments    payment[]
}

model audit {
  id        String   @id
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String   @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId], map: "Audit_userId_fkey")
}

model Category {
  id               String          @id @default(cuid())
  name             String
  description      String?
  applicationFee   Float
  Requirements     String
  documentTemplate String?
  status           category_status @default(active)
  createdAt        DateTime        @default(now())
  applications     Application[]
}

model Document {
  id            String        @id
  applicationId String
  type          document_type
  fileName      String
  filePath      String
  uploadedAt    DateTime      @default(now())
  application   Application   @relation(fields: [applicationId], references: [id])

  @@index([applicationId], map: "Document_applicationId_fkey")
}

model otp {
  id        String   @id @default(uuid())
  userId    String
  code      String
  type      otp_type @default(email_verification)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id]) // <-- Add this line

  @@index([userId, type], map: "Otp_userId_type_idx")
}

model payment {
  id             String         @id
  applicationId  String
  amount         Float
  method         payment_method
  transactionRef String
  proofFile      String
  status         payment_status @default(pending)
  submittedAt    DateTime       @default(now())
  verifiedAt     DateTime?
  verifiedBy     String?
  application    Application    @relation(fields: [applicationId], references: [id])

  @@index([applicationId], map: "Payment_applicationId_fkey")
}

model Supplier {
  id                 String          @id @default(cuid())
  user               user            @relation(fields: [userId], references: [id])
  userId             String          @unique
  companyName        String
  tpin               String
  registrationNumber String
  contactPerson      String
  phone              String
  email              String
  address            String
  status             supplier_status @default(active)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  applications       Application[]
}

model user {
  id            String      @id @default(uuid())
  email         String      @unique(map: "User_email_key")
  password      String
  role          user_role
  status        user_status
  emailVerified Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  supplier      Supplier?
  otps          otp[]
}

model pendingregistration {
  id               String                   @id @default(uuid()) 
  email            String                   @unique(map: "PendingRegistration_email_key")
  password         String
  role             pendingregistration_role
  registrationData Json?
  otp              String
  otpExpiresAt     DateTime
  createdAt        DateTime                 @default(now())
}

enum document_type {
  application_form
  business_registration
  tax_certificate
  company_profile
  references
}

enum payment_method {
  bank_transfer
  mobile_money
  card
}

enum otp_type {
  email_verification
  password_reset
}

enum application_status {
  draft
  submitted
  under_review
  approved
  rejected
  withdrawn
}

enum user_role {
  supplier
  admin
  manager
  viewer
}

enum user_status {
  active
  inactive
}

enum category_status {
  active
  inactive
}

enum payment_status {
  pending
  verified
  rejected
}

enum supplier_status {
  active
  suspended
}

enum pendingregistration_role {
  admin
  supplier
  user
}
